/*************************************************
 * 料理アフィリエイト自動化
 * GitHub → GAS 自動逆同期 修正版・完成版
 *
 * GitHub上の実際のGASファイル名を安全に判定し、
 * 現在のGASプロジェクトを保持したまま
 * 対象ファイルだけGitHub版へ置き換える。
 *************************************************/

function syncGitHubToGasAuto() {
  const c = ghConfig_();
  console.log('GitHub → GAS 自動同期開始');

  const project = getGasProject_();
  if (!project.files || !project.files.length) {
    throw new Error('現在のGASプロジェクトを取得できません。');
  }

  const githubFiles = listGitHubGasFiles_(c);
  if (!githubFiles.length) {
    throw new Error('GitHubのgasフォルダにファイルがありません。');
  }

  console.log('GitHub gasファイル: ' + githubFiles.map(function(file){return file.name;}).join(', '));

  const gasServerFiles = project.files.filter(function(file) {
    return file.type === 'SERVER_JS';
  });
  if (!gasServerFiles.length) {
    throw new Error('GAS側のSERVER_JSファイルが見つかりません。');
  }

  let target = null;
  let targetGasName = null;

  /* 完全一致を最優先 */
  for (let i = 0; i < gasServerFiles.length; i++) {
    const gasName = gasServerFiles[i].name;
    const match = githubFiles.find(function(file) {
      return file.name === gasName;
    });
    if (match && !/GitHubSync|GitHubReverseFix|GitHubAutoSync|GitHubSmartSync/i.test(gasName)) {
      target = match;
      targetGasName = gasName;
      break;
    }
  }

  /* 標準コード名を優先して判定 */
  if (!target) {
    const candidates = ['コード', 'コード.gs', 'Code.gs', 'Code'];
    for (let i = 0; i < candidates.length && !target; i++) {
      const githubMatch = githubFiles.find(function(file) {
        return file.name === candidates[i];
      });
      if (!githubMatch) continue;

      const gasMatch = gasServerFiles.find(function(file) {
        return file.name === candidates[i] && !/GitHubSync|GitHubReverseFix|GitHubAutoSync|GitHubSmartSync/i.test(file.name);
      });
      const fallbackGas = gasServerFiles.find(function(file) {
        return !/GitHubSync|GitHubReverseFix|GitHubAutoSync|GitHubSmartSync/i.test(file.name);
      });

      target = githubMatch;
      targetGasName = gasMatch ? gasMatch.name : (fallbackGas ? fallbackGas.name : null);
    }
  }

  /* 最終手段でも、任意の.gsを無条件採用しない */
  if (!target) {
    throw new Error(
      'GitHub側の料理自動化コードを安全に特定できません。\n' +
      'GitHub: ' + githubFiles.map(function(file){return file.name;}).join(', ') + '\n' +
      'GAS: ' + gasServerFiles.map(function(file){return file.name;}).join(', ')
    );
  }

  if (!targetGasName) {
    throw new Error('GAS側の同期対象ファイルを安全に特定できません。');
  }

  console.log('同期対象: ' + target.path + ' → GAS ' + targetGasName);

  const githubSource = getGitHubFile_(c, target.path);

  const files = project.files.map(function(file) {
    return {
      name: file.name,
      type: file.type,
      source: typeof file.source === 'string' ? file.source : ''
    };
  });

  let replaced = false;
  files.forEach(function(file) {
    if (file.name === targetGasName) {
      file.source = githubSource;
      replaced = true;
    }
  });

  if (!replaced) {
    throw new Error('GAS側の対象ファイルを置換できませんでした。');
  }

  const scriptId = ScriptApp.getScriptId();
  const url = 'https://script.googleapis.com/v1/projects/' + encodeURIComponent(scriptId) + '/content';
  const res = UrlFetchApp.fetch(url, {
    method: 'put',
    contentType: 'application/json',
    headers: {Authorization: 'Bearer ' + ScriptApp.getOAuthToken()},
    payload: JSON.stringify({files: files}),
    muteHttpExceptions: true
  });

  const code = res.getResponseCode();
  if (code !== 200) {
    throw new Error('GAS更新失敗 HTTP ' + code + '\n' + res.getContentText());
  }

  console.log('GitHub → GAS 自動同期完了');
  console.log('同期元: ' + target.path);
  console.log('同期先: GAS ' + targetGasName);
  console.log('保持したGASファイル数: ' + files.length);

  return 'GitHub → GAS 自動同期完了: ' + target.path + ' → GAS ' + targetGasName;
}

function listGitHubGasFiles_(c) {
  const url = GH_API + '/repos/' + encodeURIComponent(c.owner) + '/' + encodeURIComponent(c.repo) + '/contents/gas?ref=' + encodeURIComponent(c.branch);
  const res = UrlFetchApp.fetch(url, {
    method: 'get',
    headers: {
      Authorization: 'Bearer ' + c.token,
      Accept: 'application/vnd.github+json'
    },
    muteHttpExceptions: true
  });
  const code = res.getResponseCode();
  if (code !== 200) {
    throw new Error('GitHub gasフォルダ取得失敗 HTTP ' + code + '\n' + res.getContentText());
  }
  const data = JSON.parse(res.getContentText());
  if (!Array.isArray(data)) {
    throw new Error('GitHub gasフォルダの形式が不正です。');
  }
  return data.filter(function(file) {
    return file.type === 'file';
  });
}

function getGitHubReverseConfig_() {
  const props = PropertiesService.getScriptProperties();
  const config = {
    owner: props.getProperty('GITHUB_OWNER'),
    repo: props.getProperty('GITHUB_REPO'),
    branch: props.getProperty('GITHUB_BRANCH') || 'main',
    token: props.getProperty('GITHUB_TOKEN')
  };
  if (!config.owner || !config.repo || !config.token) {
    throw new Error('GitHub設定が不足しています。\nGITHUB_OWNER / GITHUB_REPO / GITHUB_TOKEN を確認してください。');
  }
  return config;
}