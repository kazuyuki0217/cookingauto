/*************************************************
 * 17. API接続診断
 *************************************************/

function diagnoseRakutenApi() {

  console.log(
    '===== 楽天API診断開始 ====='
  );

  var result = {};

  try {

    result.settings =
      checkRakutenSettings();

  } catch (e) {

    result.settingsError =
      e.message;

    console.log(
      '設定エラー: ' +
      e.message
    );

    return result;
  }

  try {

    var searchResult =
      RAKUTEN2_search(
        'フライパン'
      );

    result.api =
      '接続成功';

    result.http =
      '200';

    result.count =
      searchResult.count;

    result.items =
      searchResult.items.length;

  } catch (e) {

    result.api =
      '接続失敗';

    result.error =
      e.message;

    console.log(
      'APIエラー: ' +
      e.message
    );
  }

  console.log(
    '===== 楽天API診断終了 ====='
  );

  console.log(
    JSON.stringify(
      result,
      null,
      2
    )
  );

  return result;
}


/*************************************************
 * 18. 商品候補を複数取得
 *************************************************/

function RAKUTEN2_getProductCandidates(
  keyword
) {

  var json =
    RAKUTEN2_searchItems(
      keyword,
      {
        hits: 10,
        page: 1
      }
    );

  return RAKUTEN2_normalizeItems_(
    json
  );
}


/*************************************************
 * 19. 料理記事向け商品検索
 *
 * 例：
 * 「鶏むね肉 ガーリックソテー」
 * ↓
 * フライパン
 * ↓
 * 楽天商品検索
 *************************************************/

function searchRakutenForCooking(
  keyword
) {

  var cookingKeywords = [

    'フライパン',
    '鍋',
    '包丁',
    'まな板',
    '保存容器',
    'キッチン用品'

  ];

  var results = [];

  cookingKeywords.forEach(
    function(productKeyword) {

      try {

        var items =
          RAKUTEN2_getProductCandidates(
            productKeyword
          );

        results.push({

          keyword:
            productKeyword,

          items:
            items

        });

      } catch (e) {

        results.push({

          keyword:
            productKeyword,

          error:
            e.message,

          items:
            []

        });

      }

    }
  );

  return {

    cookingKeyword:
      keyword,

    results:
      results

  };
}


