/*************************************************
 * 料理アフィリエイト自動化
 * RakutenAffiliate.gs
 *
 * 保存エラー対策版
 *
 * 特徴
 * ・トップレベル const 不使用
 * ・既存コードとの名前衝突を回避
 * ・楽天市場商品検索API 現行版対応
 * ・楽天アフィリエイトURL取得
 * ・Origin / Referer 403への自動再試行
 * ・詳細ログ
 *************************************************/


/*************************************************
 * 1. 設定取得
 *************************************************/

function RAKUTEN2_getProperty_(name) {
  var value = PropertiesService
    .getScriptProperties()
    .getProperty(name);

  if (!value) {
    throw new Error(
      'GASのスクリプトプロパティ「' +
      name +
      '」が設定されていません。'
    );
  }

  return String(value).trim();
}


/*************************************************
 * 2. 楽天API設定
 *************************************************/

function RAKUTEN2_getConfig_() {

  var config = {};

  config.applicationId =
    RAKUTEN2_getProperty_('RAKUTEN_APP_ID');

  config.accessKey =
    RAKUTEN2_getProperty_('RAKUTEN_ACCESS_KEY');

  config.affiliateId =
    PropertiesService
      .getScriptProperties()
      .getProperty('RAKUTEN_AFFILIATE_ID');

  if (config.affiliateId) {
    config.affiliateId =
      String(config.affiliateId).trim();
  }

  config.apiUrl =
    'https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20260701';

  return config;
}


/*************************************************
 * 3. 共通HTTPリクエスト
 *************************************************/

function RAKUTEN2_fetch_(url, options) {

  var response;
  var code;
  var body;

  options = options || {};

  if (!options.method) {
    options.method = 'get';
  }

  if (!options.muteHttpExceptions) {
    options.muteHttpExceptions = true;
  }

  response = UrlFetchApp.fetch(url, options);

  code = response.getResponseCode();
  body = response.getContentText();

  /*
   * 楽天側で
   *
   * REQUEST_CONTEXT_BODY_HTTP_REFERRER_MISSING
   *
   * が返る場合があるため、
   * まず通常リクエストを実行し、
   * その場合だけOrigin/Referer付きで再試行する。
   */

  if (
    code === 403 &&
    body.indexOf(
      'REQUEST_CONTEXT_BODY_HTTP_REFERRER_MISSING'
    ) !== -1
  ) {

    var retryOptions = {};

    Object.keys(options).forEach(function(key) {
      retryOptions[key] = options[key];
    });

    retryOptions.headers = {};

    if (options.headers) {
      Object.keys(options.headers).forEach(function(key) {
        retryOptions.headers[key] =
          options.headers[key];
      });
    }

    retryOptions.headers['Origin'] =
      'https://tansinfuninkazu.hatenablog.com';

    retryOptions.headers['Referer'] =
      'https://tansinfuninkazu.hatenablog.com/';

    response =
      UrlFetchApp.fetch(url, retryOptions);

    code = response.getResponseCode();
    body = response.getContentText();
  }

  return {
    response: response,
    code: code,
    body: body
  };
}


/*************************************************
 * 4. URLパラメータ生成
 *************************************************/

function RAKUTEN2_addParam_(url, key, value) {

  if (
    value === null ||
    value === undefined ||
    value === ''
  ) {
    return url;
  }

  var separator =
    url.indexOf('?') === -1
      ? '?'
      : '&';

  return (
    url +
    separator +
    encodeURIComponent(key) +
    '=' +
    encodeURIComponent(value)
  );
}


/*************************************************
 * 5. 楽天商品検索
 *************************************************/

function RAKUTEN2_searchItems(keyword, options) {

  if (!keyword) {
    throw new Error(
      '検索キーワードが指定されていません。'
    );
  }

  options = options || {};

  var config =
    RAKUTEN2_getConfig_();

  var url =
    config.apiUrl;

  /*
   * 必須
   */
  url =
    RAKUTEN2_addParam_(
      url,
      'applicationId',
      config.applicationId
    );

  /*
   * アクセスキー
   */
  url =
    RAKUTEN2_addParam_(
      url,
      'accessKey',
      config.accessKey
    );

  /*
   * 検索キーワード
   */
  url =
    RAKUTEN2_addParam_(
      url,
      'keyword',
      keyword
    );

  /*
   * JSON形式
   */
  url =
    RAKUTEN2_addParam_(
      url,
      'formatVersion',
      2
    );

  /*
   * 取得件数
   */
  url =
    RAKUTEN2_addParam_(
      url,
      'hits',
      options.hits || 10
    );

  /*
   * ページ
   */
  url =
    RAKUTEN2_addParam_(
      url,
      'page',
      options.page || 1
    );

  /*
   * アフィリエイトID
   *
   * 設定されている場合のみ送信
   */
  if (config.affiliateId) {

    url =
      RAKUTEN2_addParam_(
        url,
        'affiliateId',
        config.affiliateId
      );
  }

  /*
   * API実行
   */
  var result =
    RAKUTEN2_fetch_(
      url,
      {
        method: 'get',
        muteHttpExceptions: true
      }
    );

  /*
   * ログ
   */
  console.log(
    '楽天API HTTP: ' +
    result.code
  );

  console.log(
    '楽天API URL: ' +
    url.replace(
      /accessKey=[^&]+/g,
      'accessKey=********'
    )
  );

  /*
   * HTTPエラー
   */
  if (
    result.code < 200 ||
    result.code >= 300
  ) {

    throw new Error(
      '楽天APIエラー HTTP ' +
      result.code +
      '\n' +
      result.body
    );
  }

  /*
   * JSON解析
   */
  var json;

  try {

    json =
      JSON.parse(result.body);

  } catch (e) {

    throw new Error(
      '楽天APIのJSON解析に失敗しました。\n' +
      result.body
    );
  }

  /*
   * API側エラー
   */
  if (json.errors) {

    throw new Error(
      '楽天APIエラー:\n' +
      JSON.stringify(
        json.errors,
        null,
        2
      )
    );
  }

  return json;
}


/*************************************************
 * 6. 商品一覧を扱いやすい形に変換
 *************************************************/

function RAKUTEN2_normalizeItems_(json) {

  var items = [];

  if (
    !json ||
    !json.Items
  ) {
    return items;
  }

  json.Items.forEach(function(wrapper) {

    var item =
      wrapper.Item ||
      wrapper.item ||
      wrapper;

    items.push({

      itemName:
        item.itemName || '',

      itemCode:
        item.itemCode || '',

      itemPrice:
        item.itemPrice || '',

      itemUrl:
        item.itemUrl || '',

      affiliateUrl:
        item.affiliateUrl || '',

      shopName:
        item.shopName || '',

      shopUrl:
        item.shopUrl || '',

      imageUrl:
        item.mediumImageUrls &&
        item.mediumImageUrls.length
          ? item.mediumImageUrls[0].imageUrl
          : '',

      reviewCount:
        item.reviewCount || 0,

      reviewAverage:
        item.reviewAverage || 0

    });

  });

  return items;
}


/*************************************************
 * 7. 楽天商品検索＋整理済み結果
 *************************************************/

function RAKUTEN2_search(keyword) {

  var json =
    RAKUTEN2_searchItems(
      keyword,
      {
        hits: 10,
        page: 1
      }
    );

  return {
    keyword: keyword,

    count:
      json.count || 0,

    page:
      json.page || 1,

    first:
      json.first || 0,

    last:
      json.last || 0,

    items:
      RAKUTEN2_normalizeItems_(
        json
      )
  };
}


