/*************************************************
 * 10. 商品1件取得
 *************************************************/

function RAKUTEN2_getFirstItem(
  keyword
) {

  var result =
    RAKUTEN2_search(
      keyword
    );

  if (
    !result.items ||
    result.items.length === 0
  ) {

    return null;
  }

  return result.items[0];
}


/*************************************************
 * 11. アフィリエイトURL取得
 *************************************************/

function RAKUTEN2_getAffiliateUrl(
  keyword
) {

  var item =
    RAKUTEN2_getFirstItem(
      keyword
    );

  if (!item) {

    throw new Error(
      '商品が見つかりませんでした。\n' +
      '検索キーワード: ' +
      keyword
    );
  }

  /*
   * affiliateUrl がAPIから返っていれば
   * それを使用
   */
  if (item.affiliateUrl) {

    return item.affiliateUrl;
  }

  /*
   * 返らない場合は通常商品URLを返す
   */
  return item.itemUrl;
}


/*************************************************
 * 12. ブログ記事用の商品情報生成
 *************************************************/

function RAKUTEN2_createProductData(
  keyword
) {

  var item =
    RAKUTEN2_getFirstItem(
      keyword
    );

  if (!item) {

    return {
      success: false,
      keyword: keyword,
      message: '商品が見つかりませんでした。'
    };
  }

  return {

    success: true,

    keyword:
      keyword,

    productName:
      item.itemName,

    price:
      item.itemPrice,

    shopName:
      item.shopName,

    productUrl:
      item.itemUrl,

    affiliateUrl:
      item.affiliateUrl ||
      item.itemUrl,

    imageUrl:
      item.imageUrl,

    reviewCount:
      item.reviewCount,

    reviewAverage:
      item.reviewAverage

  };
}


/*************************************************
 * 13. ブログ用HTML生成
 *************************************************/

function RAKUTEN2_createAffiliateHtml(
  keyword
) {

  var product =
    RAKUTEN2_createProductData(
      keyword
    );

  if (!product.success) {

    return '';
  }

  var url =
    product.affiliateUrl;

  var name =
    product.productName;

  var price =
    product.price;

  var html = '';

  html +=
    '<div class="rakuten-affiliate">' +
    '\n';

  html +=
    '<p><strong>' +
    escapeHtml_(name) +
    '</strong></p>' +
    '\n';

  if (price) {

    html +=
      '<p>価格：' +
      escapeHtml_(String(price)) +
      '円</p>' +
      '\n';
  }

  html +=
    '<p>' +
    '<a href="' +
    escapeAttribute_(url) +
    '" ' +
    'target="_blank" ' +
    'rel="nofollow sponsored">' +
    '楽天市場で商品を見る' +
    '</a>' +
    '</p>' +
    '\n';

  html +=
    '</div>';

  return html;
}


/*************************************************
 * 14. HTMLエスケープ
 *************************************************/

function escapeHtml_(text) {

  if (
    text === null ||
    text === undefined
  ) {
    return '';
  }

  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}


/*************************************************
 * 15. URL属性エスケープ
 *************************************************/

function escapeAttribute_(text) {

  return escapeHtml_(text);
}


