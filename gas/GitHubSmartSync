/*************************************************
 * 料理アフィリエイト自動化
 * GitHub ⇄ GAS スマート同期
 *
 * 変更がある場合だけGASを更新する
 *************************************************/


function runGitHubSmartSync() {

  console.log(
    '================================'
  );

  console.log(
    'GitHubスマート同期 開始'
  );


  try {

    const c = ghConfig_();

    const project =
      getGasProject_();


    /*
     * GitHubのgasフォルダを取得
     */
    const githubFiles =
      listGitHubGasFiles_(c);


    if (!githubFiles.length) {
      throw new Error(
        'GitHubのgasフォルダにファイルがありません。'
      );
    }


    /*
     * GAS側のSERVER_JSを探す
     */
    const gasServerFiles =
      project.files.filter(
        function(file) {
          return (
            file.type === 'SERVER_JS' &&
            !/GitHubSync/i.test(file.name) &&
            !/GitHubReverseFix/i.test(file.name) &&
            !/GitHubAutoSync/i.test(file.name) &&
            !/GitHubSmartSync/i.test(file.name)
          );
        }
      );


    if (!gasServerFiles.length) {
      throw new Error(
        '同期対象のGASコードファイルが見つかりません。'
      );
    }


    /*
     * GitHubとGASのファイル名を照合
     */
    let target = null;
    let gasTarget = null;


    for (
      let i = 0;
      i < gasServerFiles.length;
      i++
    ) {

      const gasFile =
        gasServerFiles[i];


      const match =
        githubFiles.find(
          function(file) {
            return (
              file.name === gasFile.name
            );
          }
        );


      if (match) {

        target = match;

        gasTarget = gasFile;

        break;

      }

    }


    /*
     * 念のためCode.gs / コードを探す
     */
    if (!target) {

      target =
        githubFiles.find(
          function(file) {

            return (
              (
                file.name === 'コード' ||
                file.name === 'コード.gs' ||
                file.name === 'Code' ||
                file.name === 'Code.gs'
              ) &&
              !/GitHubSync/i.test(file.name)
            );

          }
        );


      if (target) {

        gasTarget =
          gasServerFiles[0];

      }

    }


    if (!target || !gasTarget) {

      throw new Error(
        'GitHubとGASの同期対象を特定できません。'
      );

    }


    console.log(
      '比較対象: ' +
      target.path +
      ' ⇄ GAS ' +
      gasTarget.name
    );


    /*
     * GitHubコード取得
     */
    const githubSource =
      getGitHubFile_(
        c,
        target.path
      );


    const gasSource =
      typeof gasTarget.source === 'string'
        ? gasTarget.source
        : '';


    /*
     * 内容を比較
     */
    const githubHash =
      createHash_(githubSource);

    const gasHash =
      createHash_(gasSource);


    console.log(
      'GitHub HASH: ' +
      githubHash
    );

    console.log(
      'GAS HASH: ' +
      gasHash
    );


    /*
     * 変更なし
     */
    if (githubHash === gasHash) {

      console.log(
        '変更なし'
      );

      console.log(
        'GASの更新は実行しません。'
      );

      console.log(
        '================================'
      );

      return (
        '同期不要：GitHubとGASは同一です。'
      );

    }


    /*
     * 変更あり
     */
    console.log(
      '変更を検出しました。'
    );

    console.log(
      'GitHub → GASを実行します。'
    );


    /*
     * 現在のGASファイルを保持
     */
    const files =
      project.files.map(
        function(file) {

          return {
            name: file.name,

            type: file.type,

            source:
              typeof file.source === 'string'
                ? file.source
                : ''
          };

        }
      );


    let replaced = false;


    files.forEach(
      function(file) {

        if (
          file.name ===
          gasTarget.name
        ) {

          file.source =
            githubSource;

          replaced = true;

        }

      }
    );


    if (!replaced) {

      throw new Error(
        'GASコードの置換に失敗しました。'
      );

    }


    /*
     * Apps Script APIへ反映
     */
    const scriptId =
      ScriptApp.getScriptId();


    const url =
      'https://script.googleapis.com/v1/projects/' +
      encodeURIComponent(scriptId) +
      '/content';


    const res =
      UrlFetchApp.fetch(
        url,
        {
          method: 'put',

          contentType:
            'application/json',

          headers: {
            Authorization:
              'Bearer ' +
              ScriptApp.getOAuthToken()
          },

          payload:
            JSON.stringify({
              files: files
            }),

          muteHttpExceptions: true
        }
      );


    const code =
      res.getResponseCode();


    if (code !== 200) {

      throw new Error(
        'GAS更新失敗 HTTP ' +
        code +
        '\n' +
        res.getContentText()
      );

    }


    console.log(
      'GitHub → GAS 反映完了'
    );

    console.log(
      '変更対象: ' +
      gasTarget.name
    );

    console.log(
      '保持ファイル数: ' +
      files.length
    );


    console.log(
      '================================'
    );


    return (
      '同期完了：GitHubの変更をGASへ反映しました。'
    );


  } catch (error) {

    const message =
      error &&
      error.message
        ? error.message
        : String(error);


    console.log(
      'GitHubスマート同期 エラー'
    );

    console.log(
      message
    );

    console.log(
      '================================'
    );


    return (
      '同期エラー: ' +
      message
    );

  }

}


/*************************************************
 * SHA-256ハッシュ生成
 *************************************************/

function createHash_(text) {

  const bytes =
    Utilities
      .computeDigest(
        Utilities.DigestAlgorithm.SHA_256,
        text,
        Utilities.Charset.UTF_8
      );


  return bytes
    .map(
      function(byte) {

        const value =
          byte < 0
            ? byte + 256
            : byte;

        return (
          value
            .toString(16)
            .padStart(2, '0')
        );

      }
    )
    .join('');

}