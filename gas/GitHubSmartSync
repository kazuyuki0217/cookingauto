/*************************************************
 * 料理アフィリエイト自動化
 * GitHub ⇄ GAS スマート同期
 *
 * ・変更がある場合だけGASを更新
 * ・料理本体コードを安全に同期
 * ・楽天ブラウザ検索HTMLも必ず確認して同期
 * ・コード.gsに変更がなくてもHTML同期を実行
 *************************************************/

function runGitHubSmartSync() {
  console.log('================================');
  console.log('GitHubスマート同期 開始');

  try {
    var c = ghConfig_();
    var project = getGasProject_();
    var githubFiles = listGitHubGasFiles_(c);

    if (!githubFiles.length) {
      throw new Error('GitHubのgasフォルダにファイルがありません。');
    }

    var gasServerFiles = project.files.filter(function(file) {
      return file.type === 'SERVER_JS' &&
        !/GitHubSync/i.test(file.name) &&
        !/GitHubReverseFix/i.test(file.name) &&
        !/GitHubAutoSync/i.test(file.name) &&
        !/GitHubSmartSync/i.test(file.name);
    });

    var mainNames = ['コード.gs', 'コード', 'Code.gs', 'Code'];
    var target = null;
    var gasTarget = null;

    for (var i = 0; i < mainNames.length; i++) {
      var name = mainNames[i];
      var gh = githubFiles.find(function(file) { return file.name === name; });
      var gas = gasServerFiles.find(function(file) { return file.name === name; });
      if (gh && gas) {
        target = gh;
        gasTarget = gas;
        break;
      }
    }

    if (!target) {
      var ghMain = githubFiles.find(function(file) {
        return mainNames.indexOf(file.name) !== -1;
      });
      if (ghMain) {
        var gasMain = gasServerFiles.find(function(file) {
          return mainNames.indexOf(file.name) !== -1;
        });
        if (gasMain) {
          target = ghMain;
          gasTarget = gasMain;
        }
      }
    }

    if (!target) {
      for (var j = 0; j < gasServerFiles.length; j++) {
        var gasFile = gasServerFiles[j];
        var match = githubFiles.find(function(file) {
          return file.name === gasFile.name &&
            !/バックアップ/i.test(file.name) &&
            !/backup/i.test(file.name) &&
            !/Fix/i.test(file.name) &&
            !/Compare/i.test(file.name) &&
            !/browser/i.test(file.name) &&
            !/RootTest/i.test(file.name);
        });
        if (match) {
          target = match;
          gasTarget = gasFile;
          break;
        }
      }
    }

    if (!target || !gasTarget) {
      throw new Error('料理本体コードの同期対象を安全に特定できません。');
    }

    console.log('比較対象: ' + target.path + ' ⇄ GAS ' + gasTarget.name);

    var githubSource = getGitHubFile_(c, target.path);
    var gasSource = typeof gasTarget.source === 'string' ? gasTarget.source : '';
    var githubHash = createHash_(githubSource);
    var gasHash = createHash_(gasSource);

    console.log('GitHub HASH: ' + githubHash);
    console.log('GAS HASH: ' + gasHash);

    var files = project.files.map(function(file) {
      return {
        name: file.name,
        type: file.type,
        source: typeof file.source === 'string' ? file.source : ''
      };
    });

    var changedMain = false;
    if (githubHash !== gasHash) {
      console.log('料理本体コードの変更を検出しました。');
      files.forEach(function(file) {
        if (file.name === gasTarget.name) {
          file.source = githubSource;
          changedMain = true;
        }
      });
    } else {
      console.log('料理本体コードは変更なし。');
    }

    /* 楽天ブラウザ検索HTMLを、GitHubの一覧フィルタに依存せず直接取得 */
    var bridgeName = 'RakutenBrowserBridge';
    var bridgePath = 'gas/RakutenBrowserBridge.html';
    var bridgeGh = null;
    var bridgeSource = '';

    try {
      bridgeSource = getGitHubFile_(c, bridgePath);
      bridgeGh = {name: bridgeName + '.html', path: bridgePath};
      console.log('GitHubの楽天ブラウザHTMLを確認しました。');
    } catch (bridgeError) {
      console.log('GitHubに楽天ブラウザHTMLがありません。');
    }

    var changedBridge = false;
    if (bridgeGh && bridgeSource) {
      var bridgeGasIndex = -1;

      for (var k = 0; k < files.length; k++) {
        if (files[k].name === bridgeName || files[k].name === bridgeName + '.html') {
          bridgeGasIndex = k;
          break;
        }
      }

      if (bridgeGasIndex >= 0) {
        if (files[bridgeGasIndex].source !== bridgeSource || files[bridgeGasIndex].name !== bridgeName || files[bridgeGasIndex].type !== 'HTML') {
          files[bridgeGasIndex] = {
            name: bridgeName,
            type: 'HTML',
            source: bridgeSource
          };
          changedBridge = true;
          console.log('楽天ブラウザHTMLを更新します。');
        } else {
          console.log('楽天ブラウザHTMLは変更なし。');
        }
      } else {
        files.push({
          name: bridgeName,
          type: 'HTML',
          source: bridgeSource
        });
        changedBridge = true;
        console.log('楽天ブラウザHTMLをGASへ追加します。');
      }
    }

    if (!changedMain && !changedBridge) {
      console.log('同期対象に変更なし。');
      console.log('================================');
      return '同期不要：GitHubとGASは最新状態です。';
    }

    var scriptId = ScriptApp.getScriptId();
    var url = 'https://script.googleapis.com/v1/projects/' +
      encodeURIComponent(scriptId) + '/content';

    var res = UrlFetchApp.fetch(url, {
      method: 'put',
      contentType: 'application/json',
      headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
      payload: JSON.stringify({ files: files }),
      muteHttpExceptions: true
    });

    var code = res.getResponseCode();
    if (code !== 200) {
      throw new Error('GAS更新失敗 HTTP ' + code + '\n' + res.getContentText());
    }

    console.log('GitHub → GAS 反映完了');
    console.log('保持ファイル数: ' + files.length);
    console.log('料理本体コード: ' + (changedMain ? '更新' : '変更なし'));
    console.log('楽天ブラウザHTML: ' + (changedBridge ? '更新/追加' : '変更なし'));
    console.log('================================');
    return '同期完了：GitHubの変更をGASへ反映しました。';

  } catch (error) {
    var message = error && error.message ? error.message : String(error);
    console.log('GitHubスマート同期 エラー');
    console.log(message);
    console.log('================================');
    return '同期エラー: ' + message;
  }
}

function createHash_(text) {
  var bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    text,
    Utilities.Charset.UTF_8
  );
  return bytes.map(function(byte) {
    var value = byte < 0 ? byte + 256 : byte;
    return value.toString(16).padStart(2, '0');
  }).join('');
}
