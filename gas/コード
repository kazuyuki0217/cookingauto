}


/*************************************************
 * 楽天アクセスキー保存
 *************************************************/

function セーブ楽天アクセスキー() {

  const ui = SpreadsheetApp.getUi();

  const result = ui.prompt(
    '楽天アクセスキー',
    '楽天ウェブサービスのアクセスキーを入力してください。',
    ui.ButtonSet.OK_CANCEL
  );

  if (
    result.getSelectedButton() !== ui.Button.OK
  ) {
    return;
  }

  const key =
    result.getResponseText().trim();

  if (!key) {
    throw new Error(
      '楽天アクセスキーが空です。'
    );
  }

  PropertiesService
    .getScriptProperties()
    .setProperty(
      'RAKUTEN_ACCESS_KEY',
      key
    );

  Logger.log(
    '楽天アクセスキー保存完了'
  );
}


/*************************************************
 * 楽天アクセスキー取得
 *************************************************/

function getRakutenKey_() {

  const key =
    getProperty_('RAKUTEN_ACCESS_KEY');

  if (!key) {

    throw new Error(
      '楽天アクセスキー未登録です。' +
      '「セーブ楽天アクセスキー」を先に実行してください。'
    );
  }

  return key;
}


/*************************************************
 * 楽天API共通リクエスト
 *************************************************/

function callRakutenApi_(keyword, hits) {

  const accessKey =
    getRakutenKey_();

  keyword =
    keyword || 'フライパン';

  hits =
    hits || 10;

  const params = [
    'applicationId=' +
      encodeURIComponent(
        RAKUTEN_APPLICATION_ID
      ),

    'accessKey=' +
      encodeURIComponent(
        accessKey
      ),

    'affiliateId=' +
      encodeURIComponent(
        RAKUTEN_AFFILIATE_ID
      ),

    'keyword=' +
      encodeURIComponent(
        keyword
      ),

    'hits=' +
      encodeURIComponent(
        hits
      ),

    'format=json',

    'formatVersion=2'
  ];

  const url =
    RAKUTEN_API_URL +
    '?' +
    params.join('&');

  Logger.log(
    '楽天API URL: ' + url.replace(
      accessKey,
      '********'
    )
  );

  const response =
    UrlFetchApp.fetch(
      url,
      {
        method: 'get',

        muteHttpExceptions: true,

        headers: {
          'Accept': 'application/json'
        }
      }
    );

  const status =
    response.getResponseCode();

  const body =
    response.getContentText();

  Logger.log(
    '楽天API HTTP: ' + status
  );

  if (status !== 200) {

    Logger.log(body);

    throw new Error(
      '楽天APIエラー HTTP ' +
      status +
      '\n' +
      body
    );
  }

  let data;

  try {

    data =
      JSON.parse(body);

  } catch (e) {

    throw new Error(
      '楽天APIのJSON解析に失敗しました。\n' +
      body
    );
  }

  if (
    !data.items ||
    data.items.length === 0
  ) {

    throw new Error(
      '楽天商品データがありません。'
    );
  }

  return data;
}


/*************************************************
 * 楽天商品検索
 *************************************************/

function 楽天商品検索(keyword) {

  const data =
    callRakutenApi_(
      keyword,
      10
    );

  return data.items.map(
    function(item) {

      return {

        商品名:
          item.itemName || '',

        価格:
          item.itemPrice || '',

        商品URL:
          item.itemUrl || '',

        アフィリエイトURL:
          item.affiliateUrl || '',

        ショップ名:
          item.shopName || '',

        商品画像:
          item.mediumImageUrls &&
          item.mediumImageUrls.length
            ? item.mediumImageUrls[0].imageUrl
            : '',

        レビュー件数:
          item.reviewCount || 0,

        レビュー平均:
          item.reviewAverage || 0
      };
    }
  );
}


