// 楽天アプリケーションID
const RAKUTEN_APPLICATION_ID =
  'ここに現在使用中の楽天Application ID';

// 楽天アフィリエイトID
const RAKUTEN_AFFILIATE_ID =
  'ここに現在使用中の楽天Affiliate ID';

// 楽天API 2026-07-01
