function getMyProjectSource() {

  const scriptId =
    ScriptApp.getScriptId();

  const token =
    ScriptApp.getOAuthToken();

  const url =
    'https://script.googleapis.com/v1/projects/' +
    encodeURIComponent(scriptId) +
    '/content';

  const response =
    UrlFetchApp.fetch(
      url,
      {
        method: 'get',

        headers: {
          'Authorization':
            'Bearer ' + token
        },

        muteHttpExceptions: true
      }
    );

  const result =
    response.getContentText();

  DriveApp.createFile(
    '料理自動化_現在コード取得.json',
    result,
    MimeType.PLAIN_TEXT
  );

  Logger.log(result);

  return result;
}


