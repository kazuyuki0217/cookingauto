/*************************************************
 * 料理アフィリエイト自動化
 * GitHub 自動同期・安全実行
 *
 * GitHub → GAS同期を自動実行し、変更が反映された場合だけ
 * Pinterest OAuth用の固定URLデプロイも最新版へ更新する。
 * 同期不要の場合は新しいGASバージョンを作成しない。
 *************************************************/

function runGitHubAutoSync() {
  const startedAt = new Date();

  console.log('================================');
  console.log('GitHub自動同期 開始');
  console.log('開始時刻: ' + startedAt);

  try {
    const result = syncGitHubToGasAuto();

    console.log('同期結果: ' + result);

    // Pinterest本命ボードIDをUIなしで自動設定
    try {
      if (typeof Pinterest本命ボード自動設定 === 'function') {
        var boardId = Pinterest本命ボード自動設定();
        console.log('Pinterest本命ボードID自動設定: ' + boardId);
      } else {
        console.log('Pinterest本命ボード設定関数はまだGAS側に反映されていません。');
      }
    } catch (boardError) {
      var boardMessage = boardError && boardError.message
        ? boardError.message
        : String(boardError);
      console.log('Pinterest本命ボード設定エラー: ' + boardMessage);
    }

    var oauthFixResult = '';
    try {
      oauthFixResult = KAZU_APPLY_PINTEREST_OAUTH_STATE_FIX_();
      console.log('Pinterest OAuth state修正: ' + oauthFixResult);
    } catch (oauthFixError) {
      oauthFixResult = oauthFixError && oauthFixError.message
        ? oauthFixError.message
        : String(oauthFixError);
      console.log('Pinterest OAuth state修正エラー: ' + oauthFixResult);
      console.log('GitHub/GAS同期結果は維持します。');
    }

    var deploymentResult = '';

    if (typeof result === 'string' && result.indexOf('同期完了') !== -1) {
      try {
        deploymentResult = Pinterest旧URLデプロイ最新版更新();
        console.log('固定URLデプロイ更新: ' + deploymentResult);
      } catch (deploymentError) {
        deploymentResult = deploymentError && deploymentError.message
          ? deploymentError.message
          : String(deploymentError);
        console.log('固定URLデプロイ更新エラー: ' + deploymentResult);
        console.log('GAS本体同期は成功しています。');
      }
    } else {
      console.log('GAS側に反映すべき変更がないため、通常のデプロイ更新は行いません。');
    }

    var finalMessage = result +
      (oauthFixResult ? '\n' + oauthFixResult : '') +
      '\nPinterest本命ボードID: ' + (PropertiesService.getScriptProperties().getProperty('PINTEREST_BOARD_ID') || '未設定') +
      (deploymentResult ? '\n' + deploymentResult : '');

    saveSyncLog_('SUCCESS', finalMessage, startedAt, new Date());

    console.log('GitHub自動同期 正常終了');
    console.log('================================');

    return finalMessage;

  } catch (error) {
    const message = error && error.message ? error.message : String(error);

    console.log('GitHub自動同期 エラー');
    console.log(message);

    saveSyncLog_('ERROR', message, startedAt, new Date());

    return 'GitHub自動同期エラー: ' + message;
  }
}

function KAZU_APPLY_PINTEREST_OAUTH_STATE_FIX_() {
  var scriptId = ScriptApp.getScriptId();
  var url = 'https://script.googleapis.com/v1/projects/' + encodeURIComponent(scriptId) + '/content';
  var token = ScriptApp.getOAuthToken();

  var response = UrlFetchApp.fetch(url, {
    method: 'get',
    muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + token }
  });

  var code = response.getResponseCode();
  var body = response.getContentText();
  if (code < 200 || code >= 300) {
    throw new Error('Apps Script API GET HTTP ' + code + '\n' + body);
  }

  var project = JSON.parse(body);
  if (!project.files || !project.files.length) {
    throw new Error('GASプロジェクトのファイル一覧を取得できませんでした。');
  }

  var changed = false;
  project.files = project.files.map(function(file) {
    if (file.name !== 'コード' && file.name !== 'コード.gs' && file.name !== 'Code.gs' && file.name !== 'Code') {
      return file;
    }

    if (!file.source) return file;

    var oldBlock = "function KAZU_PINTEREST_STATE_() {\n  var state = Utilities.getUuid().replace(/-/g,'');\n  PropertiesService.getScriptProperties().setProperty('PINTEREST_OAUTH_STATE',state);\n  return state;\n}\nfunction KAZU_PINTEREST_AUTH_URL_() {\n  var state = KAZU_PINTEREST_STATE_();";

    var newBlock = "function KAZU_PINTEREST_STATE_() {\n  var props = PropertiesService.getScriptProperties();\n  var state = props.getProperty('PINTEREST_OAUTH_STATE');\n  if (!state) {\n    state = Utilities.getUuid().replace(/-/g,'');\n    props.setProperty('PINTEREST_OAUTH_STATE',state);\n  }\n  return state;\n}\nfunction KAZU_PINTEREST_AUTH_URL_() {\n  var state = KAZU_PINTEREST_STATE_();";

    if (file.source.indexOf(newBlock) !== -1) return file;
    if (file.source.indexOf(oldBlock) === -1) {
      throw new Error('コード内のPinterest OAuth state対象箇所が見つかりません。');
    }

    file.source = file.source.replace(oldBlock, newBlock);
    changed = true;
    return file;
  });

  if (!changed) {
    return 'OAuth state修正済み。変更不要。';
  }

  var putResponse = UrlFetchApp.fetch(url, {
    method: 'put',
    muteHttpExceptions: true,
    contentType: 'application/json',
    headers: { Authorization: 'Bearer ' + token },
    payload: JSON.stringify({ files: project.files })
  });

  var putCode = putResponse.getResponseCode();
  var putBody = putResponse.getContentText();
  if (putCode < 200 || putCode >= 300) {
    throw new Error('Apps Script API PUT HTTP ' + putCode + '\n' + putBody);
  }

  return 'OAuth state修正をGAS本体コードへ統合しました。';
}

function saveSyncLog_(status, message, startedAt, finishedAt) {
  const props = PropertiesService.getScriptProperties();

  const log = {
    status: status,
    message: message,
    startedAt: startedAt.toISOString(),
    finishedAt: finishedAt.toISOString()
  };

  props.setProperty('GITHUB_LAST_SYNC_LOG', JSON.stringify(log));
  props.setProperty('GITHUB_LAST_SYNC_STATUS', status);
  props.setProperty('GITHUB_LAST_SYNC_TIME', finishedAt.toISOString());
}

function getGitHubAutoSyncStatus() {
  const props = PropertiesService.getScriptProperties();
  const status = props.getProperty('GITHUB_LAST_SYNC_STATUS');
  const time = props.getProperty('GITHUB_LAST_SYNC_TIME');
  const log = props.getProperty('GITHUB_LAST_SYNC_LOG');

  if (!log) return '同期履歴はまだありません。';

  return '状態: ' + status + '\n' +
    '時刻: ' + time + '\n' +
    '詳細: ' + log;
}

/*************************************************
 * GitHub自動同期トリガー設定
 *
 * 既存の同名トリガーを削除してから
 * 1時間ごとの自動実行を1つだけ作成する。
 *************************************************/

function setupGitHubAutoSyncTrigger() {
  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    if (trigger.getHandlerFunction() === 'runGitHubAutoSync') {
      ScriptApp.deleteTrigger(trigger);
    }
  });

  ScriptApp.newTrigger('runGitHubAutoSync')
    .timeBased()
    .everyHours(1)
    .create();

  return 'GitHub自動同期トリガーを1時間ごとに設定しました。';
}
